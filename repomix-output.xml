            </span>
          </div>

          {/* Hello */}
          <div key={helloKey}>
            <AppleHelloVietnameseEffect />
          </div>

          {/* Tagline */}
          <div className="mt-6 space-y-2">
            <p className="text-base md:text-lg font-semibold text-gray-800">Welcome to 👋</p>
