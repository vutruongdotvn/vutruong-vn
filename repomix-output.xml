              </button>

              <button
                onClick={onRefreshCurrent}
                className="rounded-2xl bg-black text-white hover:opacity-90 text-sm font-medium px-4 py-3.5 transition-all cursor-pointer"
              >
                <i className="fa-duotone fa-rotate-right mr-2" />
                Refresh
              </button>
            </div>
          </motion.div>
        </motion.div>
      )}
    </AnimatePresence>
  );
}
